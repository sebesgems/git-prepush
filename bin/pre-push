#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Generated by git_prepush. Safe to edit — rerun `rake git_prepush:install` to reset.
# Runs project health checks before push. Only checks for tooling actually
# present in the project are run; the rest are skipped silently.

if ENV['CI_PREPUSHSKIP'] == '1'
  puts 'CI_PREPUSHSKIP=1, skipping all pre-push checks.'
  exit 0
end

# ---- Output ----------------------------------------------------------------
COLOR = $stdout.tty?
def colorize(code, msg)
  COLOR ? "\e[#{code}m#{msg}\e[0m" : msg
end
def info(m)     = puts colorize('1;34', "▶ #{m}")
def ok(m)       = puts colorize('1;32', "✓ #{m}")
def warn_msg(m) = puts colorize('1;33', "! #{m}")
def fail_msg(m) = puts colorize('1;31', "✗ #{m}")

# ---- Workspace -------------------------------------------------------------
root = `git rev-parse --show-toplevel 2>/dev/null`.strip
Dir.chdir(root) unless root.empty?

unless system('command -v bundle >/dev/null 2>&1')
  fail_msg 'Bundler not installed.'
  exit 1
end

# ---- Detection -------------------------------------------------------------
LOCK = File.exist?('Gemfile.lock') ? File.read('Gemfile.lock') : ''

def gem_present?(name)
  LOCK.include?("\n    #{name} (")
end

def binstub_or_bundle(stub, exe)
  File.executable?("bin/#{stub}") ? "bin/#{stub}" : "bundle exec #{exe}"
end

rails_app = File.exist?('config/application.rb')
ENV['RAILS_ENV'] = 'test' if rails_app

# ---- Step list -------------------------------------------------------------
# [label, command, env_var_that_skips_it]
steps = []

if File.exist?('.rubocop.yml') || gem_present?('rubocop')
  steps << ['RuboCop', "#{binstub_or_bundle('rubocop', 'rubocop')} -f github",
            'CI_PREPUSHSKIP_RUBOCOP']
end

if rails_app && gem_present?('brakeman')
  steps << ['Brakeman', "#{binstub_or_bundle('brakeman', 'brakeman')} --no-pager --quiet",
            'CI_PREPUSHSKIP_BRAKEMAN']
end

if gem_present?('database_consistency')
  cfg = File.exist?('.database_consistency.todo.yml') ? ' -c .database_consistency.todo.yml' : ''
  steps << ['DatabaseConsistency', "bundle exec database_consistency#{cfg}",
            'CI_PREPUSHSKIP_DB_CONSISTENCY']
end

if File.exist?('sorbet/config')
  steps << ['Sorbet', "#{binstub_or_bundle('srb', 'srb')} tc",
            'CI_PREPUSHSKIP_SORBET']
end

test_cmd =
  if File.executable?('bin/tests')
    'bin/tests'
  elsif rails_app
    "#{binstub_or_bundle('rails', 'rails')} test"
  elsif Dir.exist?('spec') && gem_present?('rspec-core')
    binstub_or_bundle('rspec', 'rspec')
  elsif Dir.exist?('test') && gem_present?('minitest')
    'bundle exec rake test'
  end
steps << ['Tests', test_cmd, 'CI_PREPUSHSKIP_TESTS'] if test_cmd

if steps.empty?
  warn_msg 'No checks detected in this project.'
  exit 0
end

# ---- Run -------------------------------------------------------------------
steps.each do |label, cmd, skip_env|
  if ENV[skip_env] == '1'
    warn_msg "#{label} skipped (#{skip_env}=1)"
    next
  end

  info label
  if system(cmd)
    ok label
  else
    fail_msg label
    exit 1
  end
end

ok 'All pre-push checks passed.'
